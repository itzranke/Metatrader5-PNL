# ===== MT5 Journal — env vars (salin ke .env; JANGAN commit .env) =====
ENVIRONMENT=development
APP_NAME=MT5 Journal API
API_PREFIX=/api/v1

# Database (PostgreSQL lokal via docker compose)
DATABASE_URL=postgresql+psycopg://mt5:mt5@localhost:5432/mt5journal

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173

# URL frontend (dipakai untuk link email verifikasi/reset)
FRONTEND_URL=http://localhost:5173

# Keamanan — WAJIB ganti di production
SESSION_SECRET=change-me-in-production

# Quota free tier
MAX_ACCOUNTS_PER_USER=2
MAX_TRADES_PER_USER=10000

# External services (kosong = nonaktif)
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
SENTRY_DSN=
UPLOAD_DIR=uploads
